# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# next.js
/.next/
/out/

# production
/build

# testing
/coverage

# env files — never commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# editors
.idea/
.vscode/
*.swp
*.swo

# misc
*.pem
.vercel

# ─── AI coding assistants ──────────────────────────────────────────────────────

# Claude Code — keep CLAUDE.md and settings.json (shared project config),
# but exclude local overrides and per-user memory
.claude
.claude/projects/
.claude/todos/

# Cursor — keep .cursorrules (shared), exclude local state and model cache
.cursor/chat/
.cursor/logs/
.cursor/mcp.json

# Aider — conversation history leaks partial code and is large
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v*/

# Cline / Continue / Copilot Chat local history
.cline/
.continue/chats/
.github/copilot-workspace/

# Windsurf
.windsurf/

# ─── Agentic / LLM runtime artifacts ──────────────────────────────────────────

# Agent scratchpads, intermediate reasoning traces, and temp tool outputs
agent_workspace/
.agent/
scratch/

# Prompt / response cache (saves tokens but must not be committed)
.llm_cache/
.prompt_cache/
*.llm_cache

# Local vector stores and embedding indexes written during RAG workflows
chroma/
.chroma/
faiss_index/
*.faiss
*.index
*.pkl

# MCP server local state and sqlite caches written by tool servers
mcp_data/
.mcp/

# LLM evals output — generated, not source
evals_output/
eval_results/
